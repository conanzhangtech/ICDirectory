{{/* Content adapter: one profile page per record in data/volunteers.json.
     The JSON is the single source of truth — swap it for a CMS, D1 database
     or the Volunteer Management System later without touching templates. */}}
{{ range $v := site.Data.volunteers }}
  {{ $page := dict
    "path" $v.slug
    "title" $v.name
    "kind" "page"
    "params" $v
  }}
  {{ $.AddPage $page }}
{{ end }}
